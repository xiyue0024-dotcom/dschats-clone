# ============================================================
#  DSChats 复刻版 · 环境变量示例
#  复制成 .env 后按需修改。所有变量都是可选的。
# ============================================================

# ---------- 服务 ----------
# 云平台会自动注入 PORT，本地默认 5173
PORT=5173
# 容器里必须 0.0.0.0；本地建议 127.0.0.1
HOST=127.0.0.1

# ---------- 加密主密钥（云端必填）----------
# 用于加密用户填写的模型 API Key。
# 生成方式：openssl rand -hex 32
# 不填会退回到 data/.secret 文件；文件系统不持久的平台必须填这一项，
# 否则每次重启用户已保存的 Key 都会失效。
APP_SECRET=

# ---------- 数据存储 ----------
# 不填：数据写到 data/db.json（需要持久磁盘 / 持久卷）
# 填了：数据存到 Upstash Redis（纯 HTTP，免费额度够用，适合无盘平台）
# 控制台：https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 可选，默认 dschats:db
UPSTASH_KEY=

# ---------- Telegram 通道（可选）----------
# 在 @BotFather 创建机器人后填入，例如 123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=

# ============================================================
#  注意：这里不需要、也不应该放大模型 API Key。
#  模型 Key 由每个用户登录后在「设置 → AI 模型」自己填，
#  按账号隔离、AES-256-GCM 加密存储、接口只回掩码。
# ============================================================
